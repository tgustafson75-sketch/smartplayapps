{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/media-private.js": {
      "includeFiles": "private-media/**"
    }
  },
  "rewrites": [
    { "source": "/media/private", "destination": "/api/media-private" },
    { "source": "/media/private/:file/download", "destination": "/api/media-private?f=:file&dl=1" },
    { "source": "/media/private/:file", "destination": "/api/media-private?f=:file" }
  ],
  "redirects": [
    { "source": "/book", "destination": "https://calendar.google.com/calendar/appointments/schedules/AcZssZ1hYlLn6Bqfy79nvn4Y5kpmsCmsd-QCoWXe6oqDt9LhGvYOiLunR27eUWu5nWZ4zSQJ2cLduK4W", "permanent": false },
    { "source": "/cohort", "destination": "https://forms.gle/ouiKeLuPURhshB3F9", "permanent": false }
  ],
  "headers": [
    {
      "source": "/media/(access|private)(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
